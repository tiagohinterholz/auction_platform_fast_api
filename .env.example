# Copy to .env and adjust. Values below match what docker-compose.yml expects
# out of the box — hostnames (postgres, redis, rabbitmq, mailpit) only resolve
# from inside the Docker network, not from your host machine.

PYTHONPATH=.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://auction_user:auction_password@postgres:5432/auction_db

# --- Redis (locks + Celery broker) ---
REDIS_URL=redis://redis:6379/0

# --- Auth / JWT ---
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ACCESS_SECRET=change-me-too
JWT_REFRESH_SECRET=and-me-as-well

# --- Sentry (error monitoring) — optional, app runs fine without it ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# --- Logging ---
LOG_FORMAT=text
# LOG_FORMAT=json

# --- E-mail ---
EMAIL_PROVIDER=mailpit
EMAIL_FROM=no-reply@auction-platform.local
MAILPIT_SMTP_HOST=mailpit
MAILPIT_SMTP_PORT=1025
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=

# --- Event bus ---
# memory: in-process, no extra infra, what the test suite always uses.
# rabbitmq: real broker, required for events to cross the api/worker process boundary
#           (e.g. the "auction finished" WebSocket notification).
EVENT_BUS_PROVIDER=memory
# EVENT_BUS_PROVIDER=rabbitmq
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
